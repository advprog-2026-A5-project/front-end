# Auth
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth

# Kebun
KEBUN_DB_NAME=kebun_db
KEBUN_DB_USER=kebun_user
KEBUN_DB_PASSWORD=change_me_kebun

# Hasil Panen
HASIL_PANEN_DB_NAME=hasil_panen_db
HASIL_PANEN_DB_USER=hasil_panen_user
HASIL_PANEN_DB_PASSWORD=change_me_hasil

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRATION=3600000
AUTH_INTERNAL_API_TOKEN=change_me_internal_api_token

# Frontend public base URLs (replace with EC2 public host/IP)
NEXT_PUBLIC_AUTH_API_URL=http://EC2_PUBLIC_HOST:8080
NEXT_PUBLIC_KEBUN_API_URL=http://EC2_PUBLIC_HOST:8081
NEXT_PUBLIC_HASIL_PANEN_API_URL=http://EC2_PUBLIC_HOST:8082
